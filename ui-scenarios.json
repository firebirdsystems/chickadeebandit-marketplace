        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_marketplace__listings (id, title, description, price_cents, category, pickup_details, status, seller_id, seller_name, created_at, updated_at) VALUES (?, ?, ?, 4500, 'furniture', ?, 'active', ?, ?, datetime('now'), datetime('now'))",
          "params": [
