          "selector": "[data-testid=\"listing-card\"][data-listing-id=\"ui-listing\"]"
        },
        {
          "action": "click",
          "as": "mod",
          "selector": "[data-testid=\"listing-card\"][data-listing-id=\"ui-listing\"]"
        },
        {
          "action": "expectVisible",
          "as": "mod",
          "selector": "[data-testid=\"listing-detail\"][data-listing-status=\"active\"]"
